# ─────────────────────────────────────────────────────────────
# AgroVision Assistant — Environment Variables
# Copy this file to .env and fill in your API keys
# ─────────────────────────────────────────────────────────────

# Google Gemini API (free at https://aistudio.google.com)
# Powers: text chat, image analysis, disease detection
GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeatherMap API (free at https://openweathermap.org/api)
# Powers: live weather data and farming alerts
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ─────────────────────────────────────────────────────────────
# NOTE: Without these keys the assistant runs in OFFLINE MODE
# using a built-in agricultural knowledge base.
# ─────────────────────────────────────────────────────────────
